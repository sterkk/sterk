# ╔══════════════════════════════════════════════════╗
# ║         STERK v2 — Ortam Değişkenleri            ║
# ╚══════════════════════════════════════════════════╝
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.

# Uygulama
SECRET_KEY=buraya-rastgele-gizli-anahtar-yazin
FLASK_ENV=development

# PostgreSQL Veritabanı
# Yerel kullanım:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sterk
DB_USER=postgres
DB_PASSWORD=
# Veya direkt URL:
# DATABASE_URL=postgresql://user:pass@host:5432/sterk

# ── CLOUDINARY (Medya Depolama) ──────────────────
# 1. https://cloudinary.com adresinden ücretsiz hesap aç
# 2. Dashboard > "API Environment variable" kısmını kopyala
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── E-POSTA (SMTP) ──────────────────────────────
# Gmail kullanmak için:
# 1. Google Hesap > Güvenlik > 2 Adımlı Doğrulama'yı aç
# 2. Google Hesap > Güvenlik > Uygulama Şifreleri > yeni şifre oluştur
# 3. 16 haneli şifreyi SMTP_PASS'a yapıştır
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=noreply@sterk.app  # İsteğe bağlı, boşsa SMTP_USER kullanılır
