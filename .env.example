# STERK v2 — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.

SECRET_KEY=buraya_guclu_bir_anahtar_girin
FLASK_ENV=development

# PostgreSQL Veritabanı
# DATABASE_URL=postgresql://user:password@host:5432/sterk

# Cloudinary — Dashboard'dan aldığınız URL'yi buraya yapıştırın:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# E-posta (isteğe bağlı — yoksa e-posta gönderilmez)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
